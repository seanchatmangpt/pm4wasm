pm:object-relation a skos:Concept ; skos:prefLabel "Object relation witness" ; dcterms:description "Preserves typed object relations in event and receipt evidence." ; pm:artifact "WASM|Rust" ; pm:runtime "ggen|wasm4pm" ; pm:authority "CONSTRUCT_ONLY" .
