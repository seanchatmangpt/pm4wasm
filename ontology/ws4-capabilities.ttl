pm:exact-subject-identity a skos:Concept ; skos:prefLabel "Exact subject identity" ; dcterms:description "Pins generated consequences to an exact repository subject identity." ; pm:artifact "WASM|Rust" ; pm:runtime "wasm-bindgen|serde" ; pm:authority "VERIFY_ONLY" .
pm:authority-contract a skos:Concept ; skos:prefLabel "Authority contract" ; dcterms:description "Carries explicit SELECT CONSTRUCT VERIFY and BRCE-boundary authority semantics." ; pm:artifact "Rust|JSON" ; pm:runtime "wasm-bindgen|serde" ; pm:authority "VERIFY_ONLY" .
pm:receipt-policy a skos:Concept ; skos:prefLabel "Receipt policy" ; dcterms:description "Requires consequence receipts to bind subject authority and result identity." ; pm:artifact "WASM|Rust" ; pm:runtime "ggen|wasm4pm" ; pm:authority "VERIFY_ONLY" .
pm:deterministic-replay a skos:Concept ; skos:prefLabel "Deterministic replay" ; dcterms:description "Replays the same admitted inputs to the same projected consequence." ; pm:artifact "Rust|JSON" ; pm:runtime "wasm-bindgen|serde" ; pm:authority "VERIFY_ONLY" .
pm:ocel-evidence a skos:Concept ; skos:prefLabel "OCEL evidence" ; dcterms:description "Emits object-centric event evidence for process observation without actuation authority." ; pm:artifact "WASM|Rust" ; pm:runtime "wasm-bindgen|serde" ; pm:authority "CONSTRUCT_ONLY" .
pm:idempotency-contract a skos:Concept ; skos:prefLabel "Idempotency contract" ; dcterms:description "Provides stable idempotency identity for repeated runtime requests." ; pm:artifact "Rust|JSON" ; pm:runtime "ggen|wasm4pm" ; pm:authority "CONSTRUCT_ONLY" .
pm:transaction-boundary a skos:Concept ; skos:prefLabel "Transaction boundary" ; dcterms:description "Declares bounded transactional scope around state-changing workflow activities." ; pm:artifact "WASM|Rust" ; pm:runtime "wasm-bindgen|serde" ; pm:authority "CONSTRUCT_ONLY" .
pm:compensation-contract a skos:Concept ; skos:prefLabel "Compensation contract" ; dcterms:description "Declares compensating action requirements for reversible workflow effects." ; pm:artifact "Rust|JSON" ; pm:runtime "wasm-bindgen|serde" ; pm:authority "CONSTRUCT_ONLY" .
pm:retry-policy a skos:Concept ; skos:prefLabel "Retry policy" ; dcterms:description "Defines bounded retry semantics with typed exhaustion behavior." ; pm:artifact "WASM|Rust" ; pm:runtime "ggen|wasm4pm" ; pm:authority "CONSTRUCT_ONLY" .
pm:timeout-policy a skos:Concept ; skos:prefLabel "Timeout policy" ; dcterms:description "Defines explicit runtime timeout bounds and typed timeout standing." ; pm:artifact "Rust|JSON" ; pm:runtime "wasm-bindgen|serde" ; pm:authority "CONSTRUCT_ONLY" .
pm:schema-contract a skos:Concept ; skos:prefLabel "Schema contract" ; dcterms:description "Binds runtime payloads to an admitted schema identity." ; pm:artifact "WASM|Rust" ; pm:runtime "wasm-bindgen|serde" ; pm:authority "VERIFY_ONLY" .
pm:typed-refusal a skos:Concept ; skos:prefLabel "Typed refusal" ; dcterms:description "Preserves REFUSED as a typed non-actuating result distinct from failure." ; pm:artifact "Rust|JSON" ; pm:runtime "ggen|wasm4pm" ; pm:authority "VERIFY_ONLY" .
pm:dependency-digest a skos:Concept ; skos:prefLabel "Dependency digest" ; dcterms:description "Binds consumer behavior to exact dependency identity." ; pm:artifact "WASM|Rust" ; pm:runtime "wasm-bindgen|serde" ; pm:authority "VERIFY_ONLY" .
pm:config-digest a skos:Concept ; skos:prefLabel "Configuration digest" ; dcterms:description "Binds projected behavior to exact admitted configuration identity." ; pm:artifact "Rust|JSON" ; pm:runtime "wasm-bindgen|serde" ; pm:authority "VERIFY_ONLY" .
pm:capability-version a skos:Concept ; skos:prefLabel "Capability version identity" ; dcterms:description "Carries exact capability version identity into generated runtime surfaces." ; pm:artifact "WASM|Rust" ; pm:runtime "ggen|wasm4pm" ; pm:authority "VERIFY_ONLY" .
pm:execution-clock a skos:Concept ; skos:prefLabel "Execution clock identity" ; dcterms:description "Binds runtime evidence to an explicit execution clock identity." ; pm:artifact "Rust|JSON" ; pm:runtime "wasm-bindgen|serde" ; pm:authority "VERIFY_ONLY" .
pm:rate-limit a skos:Concept ; skos:prefLabel "Rate limit contract" ; dcterms:description "Declares bounded request capacity and refusal when capacity is exceeded." ; pm:artifact "WASM|Rust" ; pm:runtime "wasm-bindgen|serde" ; pm:authority "CONSTRUCT_ONLY" .
pm:error-contract a skos:Concept ; skos:prefLabel "Domain error contract" ; dcterms:description "Projects stable typed domain errors instead of unstructured failures." ; pm:artifact "Rust|JSON" ; pm:runtime "ggen|wasm4pm" ; pm:authority "CONSTRUCT_ONLY" .
pm:persistence-contract a skos:Concept ; skos:prefLabel "Persistence contract" ; dcterms:description "Declares durable state identity and replay-safe persistence boundaries." ; pm:artifact "WASM|Rust" ; pm:runtime "wasm-bindgen|serde" ; pm:authority "CONSTRUCT_ONLY" .
